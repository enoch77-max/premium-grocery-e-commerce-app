# ─────────────────────────── Fresco production env ───────────────────────────
# Copy to .env and fill in. Never commit .env.

# Postgres. POSTGRES_PASSWORD is consumed by docker-compose to create the role;
# DATABASE_URL is what the app uses (host = the compose service name "postgres").
POSTGRES_PASSWORD=CHANGE_ME_STRONG
DATABASE_URL=postgresql://fresco:CHANGE_ME_STRONG@postgres:5432/fresco

# Public origin, used for TLS, sitemap, canonicals and cookie decisions
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NODE_ENV=production

# Who may embed the store in an iframe.
#   leave unset  → hosted previews (arena.ai / *.e2b.app) + same-origin
#   'self'       → only your own pages (recommended once live on your domain)
#   'none'       → never framed (strictest; use if you never embed it)
FRAME_ANCESTORS='self'


# ── Bootstrap demo catalogue (idempotent; set to 0 for a clean production DB) ──
SEED_DEMO_DATA=1

# Demo shopper. These are THE source of truth: the account is created/updated
# automatically on the first sign-in request (and by scripts/seed-admin.mjs), so
# changing them here and redeploying is all that is required. The storefront's
# "demo shopper" button signs in as this account.
DEMO_EMAIL=jordan@fresco.demo
DEMO_PASSWORD=frescodemo
DEMO_NAME=Jordan Smith
# DEMO_PHONE=(555) 012-3456

# Owner account. Created/updated at boot the same way.
# Set ADMIN_PASSWORD_SYNC=0 if you rotate the password and do not want the
# environment value to overwrite it on the next restart.
ADMIN_EMAIL=owner@your-domain.example
ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_16_CHARS
ADMIN_NAME=Store Owner
# ADMIN_PASSWORD_SYNC=1

# Password recovery. While transactional email is not configured the reset link is
# returned by the API and logged, so a locked-out shopper can still recover.
# Set to 0 once Postmark/Resend/SES is sending mail, so the link is never exposed.
RESET_LINK_INLINE=1

# ── Backups ──
BACKUP_DIR=/var/backups/fresco
BACKUP_RETENTION_DAYS=14
BACKUP_PASSPHRASE=CHANGE_ME_LONG_RANDOM          # encrypts each dump (gpg AES-256)
# Optional offsite copy (rclone remote name + path)
RCLONE_REMOTE=
RCLONE_PATH=fresco-backups

# ── TLS (Caddy needs these only for the DNS-01 path; HTTP-01 needs just the domain) ──
DOMAIN=your-domain.example
ACME_EMAIL=owner@your-domain.example
