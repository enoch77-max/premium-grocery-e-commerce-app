# systemd alternative to Docker (Node 22 + local Postgres on the same host).
[Unit]
Description=Fresco storefront
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=fresco
WorkingDirectory=/srv/fresco
EnvironmentFile=/srv/fresco/.env
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/fresco/.next
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
